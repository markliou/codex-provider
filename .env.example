CODEX_POOL_API_KEY=replace-with-a-long-random-api-key
CODEX_POOL_ADMIN_PASSWORD_HASH=pbkdf2-sha256:replace-with-output-from-hash-password
CODEX_POOL_DATA_DIR=/data
# One HTTP listener serves /v1 and /admin. A non-loopback bind intentionally
# exposes both surfaces and therefore requires the explicit acknowledgement.
CODEX_POOL_ADDR=:8317
CODEX_POOL_ALLOW_REMOTE_ADMIN=true
# Behind a reverse proxy (for example Caddy on the edge_proxy network), name
# its network so the login lockout counts real clients, not the proxy:
# CODEX_POOL_TRUSTED_PROXIES=172.18.0.0/16
CODEX_POOL_DEFAULT_MODEL=gpt-6.1-sol(xhigh)
# Balance new sessions across equal-priority healthy accounts. Use sticky_failover
# for the legacy strict-priority behavior.
CODEX_POOL_ROUTING_STRATEGY=sticky_balanced
CODEX_POOL_SESSION_AFFINITY_TTL_MS=86400000
CODEX_POOL_MAX_RETRY_ACCOUNTS=0
# Share of a quota window held back from routing. Upstream bills the overage
# against flexible credits once an included allowance runs out, so a window is
# treated as consumed at or below this floor. 0 spends it to the last token.
# CODEX_POOL_QUOTA_FLOOR_PERCENT=1
CODEX_POOL_PROMPT_CACHE_KEY_MODE=auto
# Preserve the client key by default. lineage/project/user explicitly replace it
# with a deterministic hashed and bucketed upstream key.
CODEX_POOL_PROMPT_CACHE_KEY_POLICY=preserve
CODEX_POOL_PROMPT_CACHE_KEY_SCOPE=auto
CODEX_POOL_PROMPT_CACHE_BUCKETS=4
# Optional override. Default is 24h; use passthrough to preserve the upstream default.
# CODEX_POOL_PROMPT_CACHE_RETENTION=24h
# Optional. Initial default for the admin Console "Use Pro last" switch. When true,
# accounts are spent in three tiers: ordinary accounts first, then Pro 100 (Pro Lite),
# then Pro 200/500. A session on a higher tier moves down once a lower tier can serve it.
# Accounts whose reset credit expires within seven days (red outline) come first,
# Pro included, and Use Pro last orders them among themselves.
# CODEX_POOL_PRESERVE_PRO_QUOTA=false
# Optional. Initial default for the admin Console "Keep subagents together" switch.
# When true (default), a Codex main agent and its subagents share one account.
# CODEX_POOL_LINEAGE_AFFINITY=true
# Optional. Initial default for the admin Console "Prime idle accounts" switch.
# When true, the pool sends one small request to start an idle account's quota
# window early; no native Codex sends it, so it is off by default.
# CODEX_POOL_QUOTA_PRIME=false

# Optional test/compatibility override. Default is CODEX_POOL_CODEX_BASE_URL + /wham/usage.
# CODEX_POOL_CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
# Optional test/compatibility override for reset-credit expiry details.
# CODEX_POOL_CODEX_RESET_CREDITS_URL=https://chatgpt.com/backend-api/wham/rate-limit-reset-credits

# Optional legacy provider gateway for non-Codex OpenAI-compatible providers.
# Codex/ChatGPT accounts should be added in the admin UI and authenticated with device auth.
# CODEX_POOL_UPSTREAM_BASE_URL=https://api.openai.com/v1
# CODEX_POOL_UPSTREAM_API_KEY=sk-...
# CODEX_POOL_UPSTREAM_WIRE_API=responses
